# CareerSync Environment Configuration Template
# Only variables actually consumed by the application or required by setup are listed below.

# Database URL for SQLAlchemy ORM persistence (Default: SQLite local file)
# Consumed in: app/infrastructure/persistence/database.py
DATABASE_URL=sqlite:///careersync.db

# Ollama LLM Service Configuration
# Consumed in: app/ai/providers/ollama.py
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Master secret key for Fernet token encryption in AuthConfig (Optional)
# Consumed in: app/infrastructure/config/auth_config.py
# ENCRYPTION_KEY=

# Calendar provider backend (D8): "memory" (default) or "google"
# Consumed in: app/api/app.py (get_calendar_provider)
CALENDAR_PROVIDER=memory